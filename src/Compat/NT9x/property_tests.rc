#include <windows.h>
101 DIALOG 0, 0, 220, 100
STYLE WS_CHILD | DS_CONTROL | DS_SETFONT
CAPTION "General"
FONT 8, "MS Sans Serif"
BEGIN
 LTEXT "General settings", -1, 8, 8, 150, 12
 CONTROL "Enable option", 1001, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 28, 150, 12
 EDITTEXT 1002, 8, 50, 180, 14, ES_AUTOHSCROLL | WS_TABSTOP
END
102 DIALOG 0, 0, 420, 280
STYLE WS_CHILD | DS_CONTROL | DS_SETFONT
CAPTION "Advanced"
FONT 8, "MS Sans Serif"
BEGIN
 LTEXT "Advanced settings", -1, 8, 8, 150, 12
 EDITTEXT 1003, 8, 30, 180, 14, ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "Bottom of scrollable page", 1004, 240, 255, 150, 12
END
